{
  "name": "hatien-product-rd",
  "private": true,
  "version": "1.3.0",
  "description": "Hà Tiên Product R&D Command Center — Apps Script deployment toolchain",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@google/clasp": "^3.0.6"
  },
  "scripts": {
    "clasp:status": "clasp show-file-status --project .clasp.json",
    "clasp:push": "clasp push --force --project .clasp.json",
    "clasp:deploy": "clasp create-deployment --project .clasp.json"
  }
}
